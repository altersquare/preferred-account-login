{
	"manifest_version": 3,
	"name": "Preferred Account Login",
	"version": "7.7.0",
	"description": "Open each service with the account you chose. No more switching between accounts.",
	"permissions": [
		"storage"
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "preferred-account-login@altersquare.io",
			"strict_min_version": "140.0"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_popup": "src/popup.html"
	},
	"host_permissions": [
		"*://*.google.com/*",
		"*://*.youtube.com/*",
		"*://*.ai.google/*"
	],
	"content_scripts": [
		{
			"matches": [
				"*://*.google.com/*",
				"*://*.youtube.com/*",
				"*://*.ai.google/*"
			],
			"js": [
				"src/browser-api.js",
				"src/rules.js",
				"src/content.js"
			],
			"run_at": "document_start"
		}
	]
}
